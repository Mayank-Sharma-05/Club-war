# =======================================================
# DATA BREACH: CRITICAL COUNTDOWN — ENVIRONMENT CONFIG
# =======================================================

# -------------------------------------------------------
# SUPABASE DATABASE & REALTIME CONFIGURATION
# -------------------------------------------------------
# Project URL from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Publishable anon/public key for browser queries & Realtime subscriptions
# Safe to expose in client-side code
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role secret key (NEVER expose to frontend; used only in server API routes)
# Used for administrative clear/reset and elevated server operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stall Operator / Admin Security PIN (Default: 1337)
OPERATOR_PIN=1337

# -------------------------------------------------------
# ELEVENLABS TEXT-TO-SPEECH (OPTIONAL)
# -------------------------------------------------------
# Sign up and obtain your API key from https://elevenlabs.io
# Leave empty to use built-in browser SpeechSynthesis fallback
ELEVENLABS_API_KEY=

# Pre-made deep, confident, expressive male voice ID from ElevenLabs library
# Default: pNInz6obpgDQGcFmaJgB ("Adam" - Deep, narration, confident gaming commander)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ElevenLabs Model ID
# Recommended: eleven_turbo_v2_5 (Lowest latency, highly expressive for gaming)
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
